{
	"name": "@ruan-cat/drill-doc",
	"description": "阮喵喵维护的钻头文档，用docx直接生成的md文档。",
	"version": "3.7.3",
	"homepage": "https://drill.ruan-cat.com",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": "22.x"
	},
	"scripts": {
		"git:fetch": "git fetch -p",
		"git:push": "git push --follow-tags",
		"git:dev-2-main": "git rebase dev main && git push --follow-tags",
		"git:main-2-dev": "git rebase main dev",
		"up-taze": "pnpm up @ruan-cat/taze-config -L && npx taze -r",
		"decompress-porn-img-package": "pnpm exec decompress-porn-img-package 'D:/store/baidu/048.蠢沫沫/'",
		"docs:dev": "vitepress dev docs --port 8080 --open",
		"neon:guard": "tsx scripts/guard-neon-cli.ts",
		"build": "turbo run //#docs:build:run --concurrency=1",
		"docs:build": "turbo run //#docs:build:run --concurrency=1",
		"docs:build:run": "vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"docs:build-vp": "vuepress-vite build docs",
		"docs:dev-vp": "vuepress-vite dev docs --clean-cache --open",
		"typecheck": "turbo run //#typecheck:run",
		"typecheck:run": "vue-tsc --noEmit",
		"docs:update-package": "pnpm dlx vp-update",
		"postinstall": "npx nuxi prepare",
		"prepare": "simple-git-hooks",
		"format": "prettier --experimental-cli --write --no-parallel .",
		"format:changelog": "pnpm exec prettier --experimental-cli --write CHANGELOG.md \"scripts/*/CHANGELOG.md\"",
		"format:docs-prettier": "prettier --experimental-cli --write ./docs/**/*.md",
		"rm:node_modules": "rimraf node_modules pnpm-lock.yaml .nuxt .vercel",
		"deploy-vercel": "vercel-deploy-tool deploy",
		"build:drill-docx2md": "tsx ./scripts/docx2md/index.ts",
		"build:doc-in-vercel": "tsx ./scripts/build-doc-in-vercel/index.ts",
		"release": "pnpm run release:sub && pnpm run release:root && pnpm run git:push",
		"release:sub": "relizy-runner release --no-publish --no-provider-release --no-push --yes",
		"release:root": "bumpp --no-push --yes --release patch",
		"release:bumpp": "bumpp --push",
		"release:dry": "relizy-runner release --dry-run --no-publish --no-provider-release --no-push --no-commit --no-clean --yes",
		"changelog": "relizy-runner changelog",
		"changelog:dry": "relizy-runner changelog --dry-run",
		"changelog:root": "changelogen --output CHANGELOG.md"
	},
	"dependencies": {
		"@ruan-cat-drill-doc/ai-vitepress-plugins": "workspace:*",
		"@ruan-cat-drill-doc/ai-vue": "workspace:*"
	},
	"devDependencies": {
		"@prettier/plugin-oxc": "^0.1.3",
		"@ruan-cat-drill-doc/ai-rag-core": "workspace:*",
		"@ruan-cat-drill-doc/ai-vue-doc": "workspace:*",
		"@ruan-cat-temp/decompress-porn-img-package": "workspace:*",
		"@ruan-cat-temp/get-cursor-token": "workspace:*",
		"@ruan-cat/commitlint-config": "^4.11.4",
		"@ruan-cat/domains": "^2.6.0",
		"@ruan-cat/taze-config": "^1.1.4",
		"@ruan-cat/utils": "^4.26.0",
		"@ruan-cat/vercel-deploy-tool": "^2.0.3",
		"@ruan-cat/vitepress-preset-config": "^3.2.4",
		"@types/degit": "^2.8.6",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^22.19.11",
		"bumpp": "^11.1.0",
		"changelogen": "^0.6.2",
		"changelogithub": "^14.0.0",
		"commitizen": "^4.3.1",
		"commitlint": "^20.4.2",
		"consola": "^3.4.2",
		"cz-git": "^1.12.0",
		"degit": "^2.8.4",
		"glob": "^11.1.0",
		"gradient-string": "^3.0.0",
		"html-to-md": "^0.8.8",
		"lint-staged": "^16.2.7",
		"lodash-es": "^4.17.23",
		"mammoth": "^1.11.0",
		"mermaid": "^10.9.5",
		"nuxt": "^3.21.1",
		"pnpm-workspace-yaml": "^1.6.0",
		"prettier": "^3.8.1",
		"prettier-plugin-lint-md": "1.0.1",
		"relizy": "^1.4.5",
		"sharp": "^0.33.5",
		"simple-git-hooks": "^2.13.1",
		"std-env": "^4.2.0",
		"taze": "^19.9.2",
		"tsx": "^4.21.0",
		"turbo": "^2.6.3",
		"vercel": "^58.9.2",
		"vite": "^6.3.5",
		"vitepress": "^1.6.4",
		"vitepress-demo-plugin": "^1.5.1",
		"vue": "^3.5.28"
	},
	"pnpm": {
		"overrides": {
			"nuxt-og-image": "5.1.9"
		},
		"packageExtensions": {
			"@nuxt/icon@1.15.0": {
				"dependencies": {
					"h3": "1.15.11"
				}
			},
			"@nuxtjs/mdc@0.18.4": {
				"dependencies": {
					"h3": "1.15.11"
				}
			},
			"@nuxtjs/mdc@0.20.2": {
				"dependencies": {
					"h3": "1.15.11"
				}
			},
			"@ztl-uwu/nuxt-content@2.13.9": {
				"dependencies": {
					"h3": "1.15.11"
				}
			},
			"nuxt-og-image@5.1.9": {
				"dependencies": {
					"h3": "1.15.11"
				}
			}
		},
		"patchedDependencies": {
			"emf-converter@2.0.2": "patches/emf-converter@2.0.2.patch",
			"@ztl-uwu/nuxt-content@2.13.9": "patches/@ztl-uwu__nuxt-content@2.13.9.patch"
		}
	},
	"author": {
		"name": "ruan-cat",
		"email": "1219043956@qq.com",
		"url": "https://github.com/ruan-cat"
	},
	"license": "MIT"
}
